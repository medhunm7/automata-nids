{
  "name": "automata-nids-root",
  "version": "1.0.0",
  "description": "Automata-Based Network Intrusion Detection System",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "seed": "npm --prefix server run seed",
    "test:automata": "npm --prefix server run test",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "network-intrusion-detection",
    "finite-automata",
    "fsm",
    "cybersecurity",
    "mern-stack"
  ],
  "author": "Full Stack Cybersecurity Engineering Team",
  "license": "MIT"
}
